<section class="returns-policy">
  <div class="page-width">
    <h1>{{ section.settings.heading }}</h1>
    <p>{{ section.settings.description }}</p>
  </div>
</section>

{% schema %}
{
  "name": "Order & Shipping",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Order and Shipping"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "We want you to love your purchase."
    }
  ],
  "presets": [
    {
      "name": "Order & Shipping"
    }
  ]
}
{% endschema %}