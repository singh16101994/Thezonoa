<section class="about-us page-width">
  <div class="about-hero">
    <div class="about-content">
      <p class="eyebrow">{{ section.settings.subtitle }}</p>

      <h1>{{ section.settings.heading }}</h1>

      <p class="description">
        {{ section.settings.description }}
      </p>
    </div>

    {% if section.settings.image %}
      <div class="about-image">
        {{
          section.settings.image
          | image_url: width: 1000
          | image_tag:
            loading: 'lazy',
            widths: '400,600,800,1000',
            alt: section.settings.heading
        }}
      </div>
    {% endif %}
  </div>

  <div class="about-values">
    {% for block in section.blocks %}
      <div class="value-card">
        <h3>{{ block.settings.title }}</h3>
        <p>{{ block.settings.text }}</p>
      </div>
    {% endfor %}
  </div>
</section>

<style>
.about-us{
max-width:1200px;
margin:auto;
padding:80px 20px;
}

.about-hero{
display:grid;
grid-template-columns:1fr 1fr;
gap:60px;
align-items:center;
}

.eyebrow{
letter-spacing:2px;
text-transform:uppercase;
color:#777;
margin-bottom:10px;
}

.about-content h1{
font-size:52px;
margin-bottom:20px;
}

.description{
font-size:18px;
line-height:1.8;
color:#555;
}

.about-image img{
width:100%;
border-radius:20px;
display:block;
}

.about-values{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
gap:25px;
margin-top:70px;
}

.value-card{
background:#fafafa;
padding:30px;
border-radius:18px;
text-align:center;
box-shadow:0 8px 24px rgba(0,0,0,.08);
}

.value-card h3{
margin-bottom:12px;
}

@media(max-width:768px){

.about-hero{
grid-template-columns:1fr;
}

.about-content h1{
font-size:36px;
}

}
</style>

{% schema %}
{
  "name": "About Us",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "OUR STORY"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "About Zonoa"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "At Zonoa, every garment is thoughtfully designed with premium fabrics, timeless aesthetics, and exceptional craftsmanship. Our mission is to create clothing that makes you feel confident every day."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero Image"
    }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Value",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Premium Quality"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Crafted using carefully selected materials."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About Us",
      "blocks": [
        {
          "type": "value"
        },
        {
          "type": "value"
        },
        {
          "type": "value"
        }
      ]
    }
  ]
}
{% endschema %}